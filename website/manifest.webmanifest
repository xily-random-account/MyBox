{
  "id": "mybox.app",
  "name": "MyBox",
  "short_name": "MyBox",
  "description": "MyBox is a tool for sketching and sharing instrumental melodies.",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#444444",
  "background_color": "#000000",
  "categories": ["music"],
  "icons": [
    {
      "src": "/icon_shadow_192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon_maskable_192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
